{
  "name": "split",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node -e \"const fs=require('node:fs');const t='apps/worker/.dev.vars';if(!fs.existsSync(t))fs.copyFileSync('.dev.vars.example',t)\" && pnpm --parallel --filter @split/worker --filter @split/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "rm -rf /tmp/wrangler-e2e-8787 /tmp/wrangler-e2e-8788 && VITE_TEST_SIGN_IN=1 pnpm build && (cd apps/worker && echo y | pnpm exec wrangler d1 migrations apply DB --local --persist-to /tmp/wrangler-e2e-8787 && echo y | pnpm exec wrangler d1 migrations apply DB --local --persist-to /tmp/wrangler-e2e-8788) && node ./node_modules/@playwright/test/cli.js test",
    "build": "pnpm --filter @split/web build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.5"
  }
}
