{
  "name": "@split/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "worker-types": "pnpm --filter @split/worker build:types",
    "typecheck": "pnpm worker-types && tsc -p tsconfig.json && tsc -p scripts/tsconfig.json",
    "lint": "pnpm worker-types && eslint .",
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build && node --experimental-strip-types scripts/check-bundle-size.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@line/liff": "^2.31.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@split/shared": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5"
  },
  "devDependencies": {
    "@split/worker": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
