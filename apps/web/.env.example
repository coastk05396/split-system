# Public build-time settings for the SPA (copy to .env.local). None of these is a secret.
# Leave them empty for local development: use the test sign-in form instead.
VITE_LIFF_ID=
VITE_GOOGLE_CLIENT_ID=
# Set to 1 only for browser-test builds; the Worker also needs TEST_SIGN_IN=1.
VITE_TEST_SIGN_IN=
