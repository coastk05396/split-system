// Local-first Worker config: `wrangler dev` runs with local D1 and KV and needs no account.
// The database_id and KV id are placeholders until the deploy ticket creates the real resources.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      // JWKS cache for Google and LINE sign-in keys.
      "binding": "JWKS_CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  "observability": { "enabled": true },
}
