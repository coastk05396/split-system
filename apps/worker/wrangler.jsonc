// Local-first Worker config: `wrangler dev` runs with local D1 and KV and needs no account.
// The database_id and KV id are placeholders until the deploy ticket creates the real resources.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "split",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "split-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      // JWKS cache for Google and LINE sign-in keys.
      "binding": "JWKS_CACHE",
      "id": "00000000000000000000000000000000",
    },
  ],
  // Public sign-in audiences; placeholders until the deploy ticket sets the real IDs.
  // SESSION_SIGNING_KEY is a Worker secret (`wrangler secret put`), locally in .dev.vars.
  // TEST_SIGN_IN is never set here, so the test sign-in route answers 404 when deployed.
  "vars": {
    "GOOGLE_CLIENT_ID": "local-google-client-id",
    "LINE_LOGIN_CHANNEL_ID": "local-line-channel-id",
  },
  // Daily reference Exchange rates, after Frankfurter publishes the ECB rates (~16:00 CET).
  "triggers": { "crons": ["30 16 * * *"] },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "split-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "split-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "JWKS_CACHE",
          "id": "00000000000000000000000000000000",
        },
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "staging-google-client-id",
        "LINE_LOGIN_CHANNEL_ID": "staging-line-channel-id",
      },
    },
    "production": {
      "name": "split-prod",
      "routes": [{ "pattern": "split.rickchen.si", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "split-prod",
          "database_id": "a817582a-d211-48f2-97dc-034a2dcfb14d",
          "migrations_dir": "migrations",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "JWKS_CACHE",
          "id": "f040707a834f4825a80dec3c35b8f2c3",
        },
      ],
      "vars": {
        "GOOGLE_CLIENT_ID": "767797660671-btvuphf42lm0ankofcchdajvuk0pu28h.apps.googleusercontent.com",
        "LINE_LOGIN_CHANNEL_ID": "2012285524",
      },
    },
  },
}
